{
  "name": "dsh-subagent-qoder",
  "description": "One-shot Qoder CLI subagent provider for DeepSeek Harness, over the Qoder Agent SDK",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-brand": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": {
      "note": "Must be >=0.1.6-alpha.2: the out-of-process helpers this provider composes (settleRunResult, subprocessRunHandle, resolveChildCwd, NO_START_CAPABILITIES, assertPositiveFinite) are absent from 0.1.5-rc.2."
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
